# Database (PostgreSQL 14+; the user needs CREATEDB)
DATABASE_URL=postgresql://blueprint:blueprint@localhost:5432/blueprint
DATABASE_URL_TEST=postgresql://blueprint:blueprint@localhost:5432/blueprint_test

# Web
APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# AI: "mock" needs no key. Use "openrouter" for real generation.
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_REASONING=anthropic/claude-sonnet-4.5
AI_MODEL_FAST=deepseek/deepseek-v3.1-terminus
AI_TIMEOUT_MS=240000
GENERATION_CONCURRENCY=4
MAX_TOKENS_PER_PROJECT=0   # 0 = no limit; set a number to cap tokens per project

# Worker / MCP
WORKER_HEALTH_PORT=3101
MCP_PORT=3102
API_URL=http://localhost:3000
MCP_PUBLIC_URL=http://localhost:3102/mcp
